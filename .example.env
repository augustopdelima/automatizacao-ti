# ---------------------------------------------------------------------------
# Provedor de IA usado na classificação dos chamados.
# Opções: "ollama" (modelo local) ou "gemini" (API do Google).
# Se não for informado, o padrão é "gemini".
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini

# --- Google Gemini (usado quando AI_PROVIDER=gemini) -------------------------
GEMINI_API_KEY=COLOQUE_SUA_CHAVE_AQUI
# Modelo do Gemini usado na classificação (padrão: gemini-3.8-flash).
# Se for trocar, liste os modelos disponíveis na sua conta e use um da lista:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY" | grep -o '"name":"models/[^"]*"'
# Ex.: GEMINI_MODEL=gemini-3.8-flash-lite
GEMINI_MODEL=gemini-3.8-flash

# --- Ollama (usado quando AI_PROVIDER=ollama) --------------------------------
# URL da API do Ollama. Há três cenários comuns:
#   1) Aplicação rodando fora de container (mesma máquina):
#      OLLAMA_BASE_URL=http://localhost:11434
#   2) Aplicação em container (Podman/Docker) e Ollama no host:
#      OLLAMA_BASE_URL=http://host.containers.internal:11434
#   3) Ollama em container na mesma rede do bot (Opção B do README, automatizada
#      pelo script scripts/subir_ollama_container.sh):
#      OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
# Modelo local a ser usado (deve estar baixado no Ollama).
OLLAMA_MODEL=gemma4:12b

# --- Telegram -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=COLOQUE_SEU_TOKEN_AQUI

# --- Persistência --------------------------------------------------------------
# Caminho do banco SQLite. Dentro do container, use o diretório do volume.
DATABASE_PATH=/app/data/automation.db

# --- Grupos das equipes no Telegram --------------------------------------------
# Descomente e preencha com o chat_id real de cada grupo. Se ficarem vazios,
# as equipes não têm grupo configurado e os chamados não são encaminhados.
# Os valores abaixo são apenas exemplos fictícios.
# EQUIPE_SUPORTE_CHAT_ID=-12002345665
# EQUIPE_INFRAESTRUTURA_CHAT_ID=-1001234567890
# EQUIPE_DESENVOLVIMENTO_CHAT_ID=-1001234567890